### DATABASE ###
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres_db:5432/zoomatech_db
SPRING_DATASOURCE_USERNAME=meu_usuario
SPRING_DATASOURCE_PASSWORD=sua_senha_segura
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_FLYWAY_ENABLED=true

### JWT & SECURITY ###
JWT_SECRET=sua_chave_jwt_secreta
JWT_EXPIRATION=86400000
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://zoomatechjr.vercel.app

### STORAGE (AWS / CLOUDFLARE R2) ###
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET_NAME=zoomatechjr
AWS_ENDPOINT=
